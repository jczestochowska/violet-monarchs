PORT=3000
# First page, before name selection — same for everyone.
GLOBAL_PASSWORD=changeme
# Gates /admin (undo a mistaken name pick from the login dropdown).
ADMIN_PASSWORD=changeme-too
# "true" = a bingo cell is only validated if the name matches bingo-cells.json.
# Leave false/unset to accept any name (no ground truth available).
BINGO_CHECK_NAMES=false
SESSION_SECRET=change-this-to-a-long-random-string
