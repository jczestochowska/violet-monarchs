<!doctype html>
<html lang="fr">
<head>
  <% title = "Union d'Alix et Baptiste" %>
  <%- include('partials/head') %>
  <!-- Added custom CSS file for glitch, custom font, and green color styles -->
  <link rel="stylesheet" href="/css/glitch.css">
</head>
<body class="home-body">
  <header class="home-header">
    <h1 class="glitch-move">Union d'Alix et Baptiste</h1>
    <span class="current-user">Connecté·e en tant que <%= currentUser %></span>
  </header>

  <section class="panel" id="solutions-section">
    <h2 class="glitch-move">Solutions</h2>
    <form id="puzzle-answer-form" class="puzzle-answer-form">
      <label for="puzzle-answer-input">Dès que tu penses avoir trouvé une solution à une énigme, entre la ci-dessous</label>
      <input type="text" id="puzzle-answer-input" autocomplete="off" placeholder="Tape ta réponse ici">
      <button type="submit">Valider</button>
    </form>
  </section>

  <section class="panel" id="leaderboard-section">
    <h2>Classement</h2>
    <div class="leaderboard-with-legend">
      <div id="leaderboard-container" class="leaderboard-container">
        <p class="loading glitch-blink">Chargement…</p>
      </div>
      <aside class="leaderboard-legend">
        <p>🥇 #1 à résoudre</p>
        <p>🥈 #2 à résoudre</p>
        <p>🥉 #3 à résoudre</p>
        <p><span class="legend-swatch"></span> Résolu</p>
        <p><span class="legend-swatch legend-swatch-blocked"></span> Bloqué</p>
      </aside>
    </div>
  </section>

  <section class="panel" id="osint-section">
    <h2>Où sont les mariés ?</h2>
    <p class="osint-hint">Appuyez sur la photo pour l'agrandir</p>
    <div class="osint-photos" id="osint-photos">
      <% [1, 2, 3].forEach(function(n) { %>
        <% if (n <= osintStage) { %>
          <button type="button" class="osint-slot osint-slot-open" data-photo="<%= n %>" aria-label="Agrandir la photo <%= n %>">
            <img src="/osint/photo/<%= n %>" alt="Photo <%= n %>">
          </button>
        <% } else { %>
          <div class="osint-slot osint-slot-locked" data-photo="<%= n %>" aria-hidden="true">?</div>
        <% } %>
      <% }); %>
    </div>
    <% if (!osintSolved) { %>
      <form id="osint-form" class="puzzle-answer-form">
        <label for="osint-input">À quel endroit a été prise cette photo, en un seul mot</label>
        <input type="text" id="osint-input" autocomplete="off" placeholder="Donne ta réponse ici">
        <button type="submit">Valider</button>
      </form>
    <% } %>
  </section>

  <section class="panel" id="bingo-section">
    <h2>Bingo</h2>
    <div class="bingo-instructions bingo-poem">
      <p>
        Cherche parmi les invités le profil de chaque cellule,<br>
        Puis scelle avec iels un selfie pas trop ridicule !
      </p>
      <p>
        Si tu formes une ligne ou colonne entière,<br>
        Les Mariés te donneront ton lot, et seront fiers.
      </p>
      <p>
        Mais veille à la description, ne commets nulle erreur,<br>
        Sous peine de voir filer le succès et l'honneur.
      </p>
      <p>
        Un visage une fois choisi ne pourra plus servir,<br>
        Ne te précipite pas, sous peine de ralentir !
      </p>
    </div>
    <% const usedGuestNames = new Set(bingoGrid.filter((c) => c.submittedName).map((c) => c.submittedName)); %>
    <% const usedGuests = allGuests.filter((g) => usedGuestNames.has(g.name)).sort((a, b) => a.label.localeCompare(b.label, 'fr')); %>
    <details class="bingo-used-names" id="bingo-used-names">
      <summary>
        <span>Personnes déjà dans la grille</span>
        <span class="bingo-used-names-count" id="bingo-used-names-count"><%= usedGuests.length %></span>
      </summary>
      <div class="bingo-used-names-list" id="bingo-used-names-list">
        <% if (usedGuests.length === 0) { %>
          <p class="bingo-used-names-empty" id="bingo-used-names-empty">Aucune pour l'instant.</p>
        <% } else { %>
          <% usedGuests.forEach(function(g) { %>
            <span class="bingo-used-name-chip"><%= g.label %></span>
          <% }); %>
        <% } %>
      </div>
    </details>
    <div class="bingo-grid" style="--grid-size: <%= gridSize %>;">
      <% bingoGrid.forEach(function(cell) { %>
        <button
          type="button"
          class="bingo-cell<%= cell.solved ? ' solved' : '' %><%= cell.lineComplete ? ' line-complete' : '' %>"
          data-cell-id="<%= cell.id %>"
          data-row="<%= cell.row %>"
          data-col="<%= cell.col %>"
          data-solved="<%= cell.solved %>"
          data-description="<%= cell.description %>"
          data-submitted-name="<%= cell.submittedName || '' %>"
        >
          <% if (cell.solved) { %>
            <span class="bingo-letter"><%= cell.letter %></span>
          <% } else { %>
            <span class="bingo-task"><%= cell.description %></span>
          <% } %>
        </button>
      <% }); %>
    </div>
  </section>

  <div class="bottom-spacer" aria-hidden="true"></div>

  <div id="bingo-modal" class="modal-overlay" hidden>
    <div class="modal-box">
      <button type="button" id="bingo-modal-close" class="modal-close-btn" aria-label="Fermer">&times;</button>
      <p id="bingo-modal-task" class="bingo-modal-task"></p>
      <form id="bingo-modal-form" enctype="multipart/form-data">
        <label for="bingo-person-name">Nom de la personne</label>
        <select id="bingo-person-name" name="personName" required>
          <option value="" disabled selected>Choisis un nom</option>
        </select>

        <label for="bingo-person-photo">Photo (selfie)</label>
        <input type="file" id="bingo-person-photo" name="selfie" accept="image/*" capture="environment" required>

        <p id="bingo-modal-error" class="error-banner" hidden></p>

        <div class="modal-actions">
          <button type="submit" id="bingo-modal-submit">Valider</button>
        </div>
      </form>
    </div>
  </div>

  <section class="panel memory-panel" id="memory-section" <% if (!memoryUnlocked) { %>hidden<% } %>>
    <div class="memory-card">
      <form id="memory-entry-form" class="memory-entry-form">
        <label for="memory-entry-input" id="memory-entry-label">Souvenirs d'Islande : </label>
        <input type="text" id="memory-entry-input" autocomplete="off">
      </form>
      <div id="memory-grid" class="memory-grid" style="--memory-cols: 15; --memory-rows: 17;"></div>
    </div>
  </section>

  <div id="bingo-popup" class="modal-overlay" hidden>
    <div class="modal-box popup-box">
      <p class="glitch-blink rgb-split" data-text="🎉 Félicitations, tu peux aller demander ton prix aux mariés !">
        🎉 Félicitations, tu peux aller demander ton prix aux mariés !
      </p>
      <button type="button" id="bingo-popup-close">Fermer</button>
    </div>
  </div>

  <div id="islande-popup" class="modal-overlay" hidden>
    <div class="modal-box popup-box">
      <p>Est-tu certain·e qu'il s'agit du bon mot caché&nbsp;? Regarde plus bas, ça pourrait t'aider.</p>
      <button type="button" id="islande-popup-close">Fermer</button>
    </div>
  </div>

  <!-- Shared correct/wrong answer feedback popup for both the solutions box
       (public/js/leaderboard.js) and the osint box (public/js/osint.js). A
       modal is much harder to miss than the old bottom toast. -->
  <div id="answer-popup" class="modal-overlay" hidden>
    <div class="modal-box popup-box">
      <p id="answer-popup-text"></p>
      <button type="button" id="answer-popup-close">Fermer</button>
    </div>
  </div>

  <div id="osint-lightbox" class="osint-lightbox" hidden>
    <button type="button" id="osint-lightbox-close" class="modal-close-btn osint-lightbox-close" aria-label="Fermer">&times;</button>
    <img id="osint-lightbox-img" alt="">
  </div>

  <button type="button" id="help-button" class="help-fab" aria-label="Besoin d'aide ?">?</button>

  <div id="help-modal" class="modal-overlay" hidden>
    <div class="modal-box">
      <p>Avez-vous un problème, vous pouvez venir voir Théo ou Justyna ou bien envoyer un message ici</p>
      <form id="help-form">
        <label for="help-message">Votre message</label>
        <textarea id="help-message" rows="4" maxlength="1000" required></textarea>
        <p id="help-error" class="error-banner" hidden></p>
        <div class="modal-actions">
          <button type="button" id="help-cancel">Annuler</button>
          <button type="submit" id="help-submit">Envoyer</button>
        </div>
      </form>
    </div>
  </div>

  <div id="toast" class="toast" hidden></div>

  <script id="leaderboard-initial-data" type="application/json"><%- JSON.stringify(leaderboard) %></script>
  <script nonce="<%= cspNonce %>">
    window.CURRENT_USER = <%- JSON.stringify(currentUser) %>;
    window.ALL_GUESTS = <%- JSON.stringify(allGuests) %>;
    window.GRID_SIZE = <%- JSON.stringify(gridSize) %>;
    window.MEMORY_REVEALED_CELLS = <%- JSON.stringify(memoryCells) %>;
  </script>
  <!-- Ajout du script Matrix Rain -->
  <script src="/js/matrix.js"></script>
  <script src="/js/leaderboard.js"></script>
  <script src="/js/bingo.js"></script>
  <script src="/js/memory.js"></script>
  <script src="/js/osint.js"></script>
  <script src="/js/help.js"></script>
</body>
</html>