<!doctype html>
<html lang="fr">
<head>
  <% title = "Union d'Alix et Baptiste" %>
  <%- include('partials/head') %>
</head>
<body class="login-body">
  <main class="login-card">
    <h1>Union d'Alix et Baptiste</h1>
    <p class="subtitle">Entre le mot de passe pour accéder au site.</p>

    <% if (error) { %>
      <p class="error-banner"><%= error %></p>
    <% } %>

    <form method="POST" action="/gate" class="login-form">
      <label for="password">Mot de passe</label>
      <div class="password-field">
        <input id="password" name="password" type="password" autocomplete="off" autofocus required>
        <button type="button" id="toggle-password" class="toggle-password-btn" aria-label="Afficher le mot de passe">👁</button>
      </div>

      <button type="submit">Entrer</button>
    </form>
  </main>
  <script src="/js/gate.js"></script>
</body>
</html>
